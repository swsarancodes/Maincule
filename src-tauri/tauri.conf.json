{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manicule",
  "version": "0.5.0",
  "identifier": "com.saran.manicule",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Manicule ☞",
        "width": 1050,
        "height": 750,
        "minWidth": 650,
        "minHeight": 450
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Distraction-Free Markdown Studio",
    "longDescription": "Manicule is an open-source, distraction-free Markdown studio that edits Markdown visually while treating your .md file as the single source of truth.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
